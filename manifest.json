{
  "manifest_version": 3,
  "name": "시간표 자동 입력기",
  "version": "0.9.12",
  "description": "EasyEdu HWPX 연간시간표를 로그인된 경기 나이스 학급시간표에 입력·저장하는 비공식 교사용 도구입니다.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://goe.neis.go.kr/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "시간표 자동 입력기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://goe.neis.go.kr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
